import "fmt"

// 固定关卡数据：进度0..13500 对应世界x=-6750..6750。
// 共用矩形数据生成可见地形并计算AABB碰撞，避免图片alpha影响落地。
var (
    levelLength = 13500
    levelStart = -6750.0
    groundY = -208.0
    blockLeft = []float64{-7480, -5705, -4480, -3352, -2149, -1210, -199, 906, 2043, 3185, 4052, 5030, 5983, -5359, -4160, -3198, 183, 1014, 2175, 6064}
    blockRight = []float64{-6250, -5019, -3820, -2690, -1654, -655, 476, 1508, 2762, 3617, 4549, 5445, 7450, -5132, -3933, -3004, 413, 1207, 2383, 6302}
    blockTop = []float64{-208, -208, -90, -170, -48, -48, -170, -48, -130, -48, -170, -48, -90, -39, 87, 2, 9, 120, 15, 88}
    playerHalfWidth = 14.0
    playerHeight = 114.0
    deathY = -420.0
    // 积分球方阵：挂在第几栋楼顶上方（楼顶索引），以及边长（3 或 5）。
    // 出生台（第 0 栋）和终点台（最后一栋）不放，避免一开局/一结算就白送分。
    orbRoof = []float64{4, 5, 9, 10, 11}
    orbSize = []float64{5, 3, 5, 3, 5}
    orbSpawned bool
    turretSpawned bool
    // 炮塔挂在第几栋楼顶、相对楼顶中点的横向偏移
    turretRoof = []float64{4, 9, 11}
    turretOffX = []float64{170, -170, 150}
    distance int
    simulationTicks int
    debugLevel = false
    cameraZoom = 0.72
    health int
    hudText string
    uiBusy bool
    dimOpacity float64
    menuOpacity float64
    wipeX float64
    maskUp bool
    hudShown = true  // the monitor starts visible (assets/index.json)
    activeMenu string
    score int
    best int
    lives int
    state string
    elapsed int
)

// Native UI binding: no world position, camera zoom or smoothing compensation.
func refreshHUD() {
    bar := ""
    for i := 0; i < 20; i++ {
        if i * 5 < health { bar = bar + "|" } else { bar = bar + "." }
    }
    hudText = fmt.Sprintf("HP %3d / 100  [%s]\nSCORE %4d   TIME %4ds   DIST %5d / 13500", health, bar, score, elapsed, distance)
}

// 镜头目标位置 + 受击/坠亡抖动。抖动只改相机目标点，几帧内自然衰减回 0。
func updateCamera() {
    // 人物位于视口水平40%。
    Camera.setXYpos Player.xpos + 80 / cameraZoom, 0
}

// ---------------------------------------------------------------------------
// Transition helpers
//
// Every UI element here is a world sprite and the camera glides towards its
// target with built-in smoothing. Two measured facts drive the whole design:
//   * viewportRect() reports the real (smoothed) visible rect, Camera.xpos() the
//     target the camera is still flying to; their gap is the remaining flight.
//   * a sprite placed from viewportRect() is exactly one frame behind the camera,
//     so during a fast flight it visibly bounces.
// Hence: the camera must never move fast while anything is visible. A big
// teleport is therefore split into small hops (see glideCameraHome).
// ---------------------------------------------------------------------------

// 立刻抖镜头若干帧。死亡/受击时 state 会马上变成 transition，
// Player 的主循环不再调用 updateCamera，所以不能指望那边的抖动逻辑。
func shakeCamera(n int) {
    // 相机是平滑跟随的（每帧只追平剩余距离的 16%），所以抖动的"目标点"必须给得
    // 又远又保持几帧，屏幕才真的会位移；只给 ±10px 会被平滑完全吃掉。
    for i := 0; i < n; i++ {
        dx := 110.0
        if i % 4 >= 2 {
            dx = -110.0
        }
        dy := 70.0
        if i % 2 == 0 {
            dy = -70.0
        }
        Camera.setXYpos Player.xpos + 80 / cameraZoom + dx, dy
        wait 0.02
    }
    Camera.setXYpos Player.xpos + 80 / cameraZoom, 0
}

// Hold until the camera has finished its glide, so that whatever is revealed
// afterwards shows a still world. The gap decays ~16% per tick, so this settles
// in well under a second; the cap only guards a pathological case.
func waitCameraStill() {
    settled := false
    for i := 0; i < 160 && !settled; i++ {
        left, _, width, _ := Camera.viewportRect()
        // 目标位置直接由玩家位置推出来，不依赖 Camera.xpos 的语义
        target := Player.xpos + 80 / cameraZoom
        gap := left + width / 2 - target
        if gap < 16 && gap > -16 {
            settled = true
        } else {
            wait 0.02
        }
    }
}

// Put the camera back on the player without any big single jump.
//
// 相机每帧只追平剩余距离的约 16%，所以一次跳 13000px 时第一帧就会位移 2000+px。
// 黑罩比视口宽出来的余量只有约 790px，而它是"上一帧"的位置，一帧错位就会漏出舞台。
// 因此这里把目标分成 ≤2200px 的若干跳，每跳后等 0.1s 让相机追上一点：
// 单帧位移被压在 400px 以内，远小于余量，整段重新定位都不会露馅。
func glideCameraHome() {
    done := false
    for i := 0; i < 14 && !done; i++ {
        left, _, width, _ := Camera.viewportRect()
        center := left + width / 2
        target := Player.xpos + 80 / cameraZoom
        gap := target - center
        if gap < 2200 && gap > -2200 {
            done = true
        } else {
            if gap > 0 {
                Camera.setXYpos center + 2200, 0
            } else {
                Camera.setXYpos center - 2200, 0
            }
            wait 0.1
        }
    }
    updateCamera
    waitCameraStill
}

// 放炮塔：只在第一次放，炮台本身不销毁
func spawnTurrets() {
    if turretSpawned { return }
    turretSpawned = true
    for i := 0; i < len(turretRoof); i++ {
        r := int(turretRoof[i])
        cx := (blockLeft[r] + blockRight[r]) / 2 + turretOffX[i]
        Orb.placeAt cx, blockTop[r] + 36
    }
}

// 重新铺积分球方阵（每次重建舞台都重来一遍）
func spawnOrbs() {
    if orbSpawned {
        broadcast "resetOrbs"
        return
    }
    orbSpawned = true
    for i := 0; i < len(orbRoof); i++ {
        r := int(orbRoof[i])
        cols := int(orbSize[i])
        cx := (blockLeft[r] + blockRight[r]) / 2
        cy := blockTop[r] + 90.0
        if cols > 3 {
            cy = blockTop[r] + 132.0
        }
        Orb.spawnGrid cx, cy, cols, 46
    }
}

// Rebuild the arena. Only ever called while the veil fully covers the stage.
func resetStage() {
    score = 0
    distance = 0
    health = 100
    lives = 100
    elapsed = 0
    simulationTicks = 0
    broadcastAndWait "resetPlayer"
    broadcast "resetChaser"
    // 相机由 glideCameraHome 分跳带回来，这里不直接甩目标点
    spawnOrbs
    spawnTurrets
    broadcast "resetTurrets"
    refreshHUD
}

// The HUD is a native overlay that draws above the stage sprites, so the veil
// cannot cover it: it has to be hidden explicitly during any menu.
func syncHUD() {
    want := state == "playing"
    if want == hudShown { return }
    hudShown = want
    hud := getWidget(Monitor, "fixedHUD")
    if want { hud.show } else { hud.hide }
}

// Slide the veil in from the left edge and park it dead centre. It is never
// dismissed by the transition that opened it: it stays parked (fully opaque)
// for the whole lifetime of the menu. Idempotent, so switching from one menu to
// another never re-opens the stage for a frame.
func maskIn() {
    if maskUp { return }
    maskUp = true
    wipeX = -2600
    dimOpacity = 100
    for i := 0; i < 13; i++ {
        wipeX = wipeX + 200
        wait 0.02
    }
    wipeX = 0
}

// Runs only after the menu is already gone: the parked veil withdraws to the
// right edge and reveals whatever has been prepared behind it. Near the end of
// the level the world fence stops the sheet from travelling far enough, so the
// tail of the slide is paired with a short fade and the reveal always ends
// clean instead of popping.
func maskOut() {
    maskUp = false
    wipeX = 0
    for i := 0; i < 13; i++ {
        wipeX = wipeX + 200
        if i >= 8 && i <= 11 {
            dimOpacity = 100 - float64(i-7)*25
        }
        wait 0.02
    }
    wipeX = 2600
    dimOpacity = 0
}

func fadeMenuIn() {
    for i := 1; i <= 20; i++ {
        menuOpacity = float64(i) * 5
        wait 0.02
    }
    menuOpacity = 100
}

// Fades the current panel out while it is still mounted on top of the parked
// veil. The veil itself is untouched here.
func fadeMenuOut() {
    for i := 19; i >= 0; i-- {
        menuOpacity = float64(i) * 5
        wait 0.02
    }
    menuOpacity = 0
}

// veil in -> panel fades in on top of the parked veil -> veil stays parked.
// Nothing behind the veil is touched here, and the camera never moves during
// this transition, so neither the veil nor the panel can bounce.
func openMenu(target string) {
    uiBusy = true
    state = "transition"
    syncHUD
    activeMenu = ""
    menuOpacity = 0
    broadcast "syncMenu"
    maskIn
    activeMenu = target
    broadcast "syncMenu"
    fadeMenuIn
    state = target
    uiBusy = false
}

// Panel fades out first, then the reveal. When the arena has to be rebuilt the
// camera also has to fly back to the level start: the veil is oversized for
// that flight, the rebuild happens while the screen is solid black behind it,
// and the slide-out only starts once the camera has landed. The reset is never
// visible and nothing on screen shivers while it happens.
func resumePlay(rebuild bool) {
    uiBusy = true
    state = "transition"
    fadeMenuOut
    activeMenu = ""
    broadcast "syncMenu"
    if rebuild {
        resetStage
        glideCameraHome
    }
    maskOut
    state = "playing"
    syncHUD
    uiBusy = false
}

onStart => {
    state = "menu"
    health = 100
    lives = 100
    Camera.setZoom cameraZoom
    Camera.setXYpos levelStart + 80 / cameraZoom, 0
    refreshHUD
    AudioCue.musicOn
    openMenu "menu"
    for {
        wait 0.02
        syncHUD
        if state == "playing" {
            refreshHUD
            simulationTicks++
            elapsed = simulationTicks / 50
        }
    }
}
onMsg "start", => { if state == "menu" && !uiBusy { AudioCue.confirm; resumePlay true } }
onMsg "restart", => { if !uiBusy && (state == "dead" || state == "won") { AudioCue.confirm; resumePlay true } }
onMsg "pause", => {
    if !uiBusy {
        if state == "playing" {
            AudioCue.confirm
            AudioCue.musicPause
            openMenu "paused"
        } else if state == "paused" {
            AudioCue.confirm
            AudioCue.musicResume
            resumePlay false
        }
    }
}
onMsg "toMenu", => {
    if !uiBusy { openMenu "menu" }
}
onMsg "finish", => {
    if state == "playing" {
        AudioCue.finish
        distance = levelLength
        score = distance
        if score > best { best = score }
        openMenu "won"
    }
}
