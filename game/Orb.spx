// 积分球：白色圆形，按 3×3 / 5×5 的方阵悬在楼顶上方。
//
// 克隆池只铺一次（main.spx 的 spawnOrbs 用 orbSpawned 保证），之后每次重建舞台
// 只让已有小球复位：吃到时不 destroy，而是 hide + 标记，复位时再 show。
// 这样处理是因为克隆总数有上限（300）：一场跑下来如果销毁再重建，
// 上一局没吃掉的还在、新的又要生成，就会顶到上限，部分小球不出现。
//
// 只占一个精灵类型（方法表预算紧张，炮塔还要留位置）。

var (
    spin float64
    taken bool
)

// x,y 是方阵中心，cols 是边长（3 或 5），step 是格间距
func spawnGrid(x float64, y float64, cols int, step float64) {
    half := float64(cols - 1) / 2.0
    for i := 0; i < cols; i++ {
        for j := 0; j < cols; j++ {
            setXYpos x + (float64(i) - half) * step, y + (float64(j) - half) * step
            clone
        }
    }
}

onMsg "resetOrbs", => {
    taken = false
    setGraphicEffect GhostEffect, 0
    show
}

onCloned => {
    taken = false
    spin = 0
    setSize 1
    setGraphicEffect GhostEffect, 0
    show
    for {
        wait 0.02
        if !taken {
            spin = spin + 6
            setHeading Direction(spin)
            if state == "playing" {
                dx := xpos - Player.xpos
                dy := ypos - (Player.ypos + 57)
                if dx < 0 { dx = -dx }
                if dy < 0 { dy = -dy }
                if dx < 34 && dy < 62 {
                    taken = true
                    score = score + 10
                    Fx.burst xpos, ypos, 4
                    AudioCue.confirm
                    hide
                }
            }
        }
    }
}

onStart => {
    hide
}
