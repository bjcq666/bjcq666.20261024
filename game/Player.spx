// 疾风行者 · 主角（Player）
// 跳跃 / 滑铲 / 碰撞扣命 + 1 秒无敌闪烁 / 菜单与暂停控制

var (
	onGround   bool
	invincible bool
)

func jump() {
	if onGround {
		onGround = false
		for i := 0; i < 9; i++ {
			changeYpos 14
			wait 0.02
		}
		for i := 0; i < 9; i++ {
			changeYpos -14
			wait 0.02
		}
		onGround = true
	}
}

func slide() {
	setSize 0.35
	wait 0.35
	setSize 0.6
}

func blink() {
	for i := 0; i < 10; i++ {
		hide
		wait 0.05
		show
		wait 0.05
	}
}

onStart => {
	onGround = true
	invincible = false
	setXYpos -150, -100
	for {
		wait 0.02
		if state == "playing" && !invincible && touching("Obstacle") {
			invincible = true
			broadcast "hit"
			blink
			invincible = false
		}
	}
}

onKey KeySpace, => {
	if state == "menu" {
		broadcast "start"
	} else if state == "playing" {
		jump
	}
}

onKey KeyUp, => {
	if state == "playing" {
		jump
	}
}

onKey KeyDown, => {
	if state == "playing" {
		slide
	}
}

onKey KeyEscape, => {
	if state == "playing" || state == "paused" {
		broadcast "pause"
	}
}

onKey KeyQ, => {
	if state == "paused" {
		broadcast "toMenu"
	}
}

onKey KeyR, => {
	if state == "dead" {
		broadcast "restart"
	}
}

onKey KeyM, => {
	if state == "dead" {
		broadcast "toMenu"
	}
}
