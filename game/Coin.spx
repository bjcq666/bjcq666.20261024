// 疾风行者 · 能量（Coin）
// 仅在 playing 状态生成与移动；暂停时冻结

onStart => {
	hide
	for {
		wait 2
		if state == "playing" {
			clone
		}
	}
}

onCloned => {
	setXYpos 260, float64(rand(-120, -40))
	show
	for {
		wait 0.02
		if state == "playing" {
			changeXpos -9 * gameSpeed * slowMul
			if touching("Player") {
				broadcast "coin"
				destroy
			}
			if xpos <= -230 {
				destroy
			}
		}
	}
}
