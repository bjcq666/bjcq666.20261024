// 疾风行者 · 能量（Coin） 960×720
// 仅在 playing 状态生成与移动；暂停时冻结

onStart => {
	hide
	for {
		wait 2
		if state == "playing" {
			clone
		}
	}
}

onCloned => {
	setXYpos 520, float64(rand(-240, -80))
	show
	for {
		wait 0.02
		if state == "playing" {
			changeXpos -18 * gameSpeed * slowMul
			if touching("Player") {
				broadcast "coin"
				destroy
			}
			if xpos <= -470 {
				destroy
			}
		}
	}
}
