// 疾风行者 · 障碍（Obstacle）
// 仅在 playing 状态生成与移动；暂停时冻结

onStart => {
	hide
	for {
		wait 1.6
		if state == "playing" {
			clone
		}
	}
}

onCloned => {
	setXYpos 260, -100
	show
	for {
		wait 0.02
		if state == "playing" {
			changeXpos -9 * gameSpeed * slowMul
			if xpos <= -230 {
				destroy
			}
		}
	}
}
